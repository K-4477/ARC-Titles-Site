# Copy to .env.local for local development. Never commit real values.

# 1 = the front end talks to the real /api (only works under `vercel dev`). Leave empty for sample data.
VITE_LIVE=

# The server values below live in Vercel -> Project -> Settings -> Environment Variables.
# `vercel dev` downloads them automatically; you only need them here to override.
# DATABASE_URL=            set by the Neon integration
# ADMIN_PASSWORD_HASH=     from `npm run hash-password`
# SESSION_SECRET=          from `npm run hash-password`

# Discord bot (optional; without these the site just doesn't post to Discord)
# DISCORD_BOT_TOKEN=        Developer Portal -> your app -> Bot -> Reset Token
# DISCORD_PUBLIC_KEY=       Developer Portal -> your app -> General Information
# DISCORD_CHANNEL_ID=       right-click the channel -> Copy Channel ID
# DISCORD_GUARDIAN_ROLE_ID= Server Settings -> Roles -> right-click Guardians -> Copy Role ID

# Reminders (set by the Upstash QStash integration)
# QSTASH_TOKEN=  QSTASH_CURRENT_SIGNING_KEY=  QSTASH_NEXT_SIGNING_KEY=  (QSTASH_URL=)
# SITE_URL=                 optional; defaults to the Vercel production domain
